[sub_resource type="Resource" id="Resource_addsub"]
script = ExtResource("3_addsub")
min_value = 100
max_value = 999

[sub_resource type="Resource" id="Resource_mul"]
script = ExtResource("4_mul")
a_min = 12
a_max = 99
b_min = 3

[sub_resource type="Resource" id="Resource_div"]
script = ExtResource("5_div")
divisor_min = 3
divisor_max = 12
quotient_min = 5
quotient_max = 30

[sub_resource type="Resource" id="Resource_ooo"]
script = ExtResource("6_ooo")
operand_max = 15
use_parentheses = true

[sub_resource type="Resource" id="Resource_pct"]
script = ExtResource("7_pct")
percents = PackedInt32Array(10, 20, 25, 50, 75)

[resource]
script = ExtResource("1_band")
id = &"grade6"
display_name = "Grade 6"
generators = [SubResource("Resource_addsub"), SubResource("Resource_mul"), SubResource("Resource_div"), SubResource("Resource_ooo"), SubResource("Resource_pct")]
