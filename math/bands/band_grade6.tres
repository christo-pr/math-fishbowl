[gd_resource type="Resource" script_class="MathBand" format=3 uid="uid://b40vnnwmj47qg"]

[ext_resource type="Script" uid="uid://d4a0fc3v1m03f" path="res://math/math_band.gd" id="1_band"]
[ext_resource type="Script" uid="uid://bjg37r5wc4u0j" path="res://math/generators/add_sub_generator.gd" id="3_addsub"]
[ext_resource type="Script" uid="uid://dp2m3j2w8j2bw" path="res://math/generators/multiply_generator.gd" id="4_mul"]
[ext_resource type="Script" uid="uid://bhk5f6bjo7ygy" path="res://math/generators/divide_generator.gd" id="5_div"]
[ext_resource type="Script" uid="uid://w0c1sssgq1hd" path="res://math/generators/order_of_ops_generator.gd" id="6_ooo"]
